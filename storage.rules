rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: check if admin
    function isAdmin() {
      return request.auth != null;
    }

    // Allow reading any public file
    match /{allPaths=**} {
      allow read: if true;
    }

    // Only admins can upload/delete
    match /hero/{file} {
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    match /about/{file} {
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    match /services/{file} {
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    match /products/{file} {
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    match /projects/{file} {
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    match /gallery/{file} {
      allow write: if isAdmin() && request.resource.size < 20 * 1024 * 1024;
    }

    match /blog/{file} {
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    match /logos/{file} {
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024;
    }

    match /team/{file} {
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024;
    }

    match /site-images/{file} {
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    match /testimonials/{file} {
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024;
    }

    match /videos/{file} {
      allow write: if isAdmin() && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
