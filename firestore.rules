rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }
    
    // Admin users - only readable by admins
    match /admin_users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false; // Only via Firebase console or Cloud Functions
    }
    
    // Leads/Contact Submissions - anyone can create, only admins can read/update/delete
    match /leads/{leadId} {
      allow create: if true; // Allow public form submissions
      allow read, update, delete: if isAdmin();
    }
    
    match /contact_submissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Public content - anyone can read published, admins can CRUD
    match /products/{productId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    match /services/{serviceId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    match /projects/{projectId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    match /gallery/{imageId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    match /blog_posts/{postId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    match /blog_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /testimonials/{testimonialId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    match /faq/{faqId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // Team members
    match /team/{memberId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Hero settings
    match /hero_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings - public read, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /seo_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
