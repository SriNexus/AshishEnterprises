rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if authenticated user is an admin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    // Helper: valid timestamp
    function hasTimestamps() {
      return request.resource.data.keys().hasAny(['createdAt', 'updatedAt']);
    }

    // ─── PUBLIC READ collections ─────────────────────────────────────
    // Anyone can read published content; only admins can write

    match /services/{docId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{docId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /projects/{docId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /blog_posts/{docId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /blog_categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /faq/{docId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /team/{docId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // ─── SETTINGS (public read, admin write) ─────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hero_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seo_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── LEADS / CONTACT (public create, admin read/write) ───────────
    match /leads/{docId} {
      allow create: if true; // Anyone can submit a lead
      allow read, update, delete: if isAdmin();
    }

    match /contact_submissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ─── ADMIN USERS (admin only) ─────────────────────────────────────
    match /admin_users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // ─── DENY EVERYTHING ELSE ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
